<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/paper">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="12dp">
        <TextView
            android:id="@+id/badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_badge"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp"
            android:text="@string/demo_badge"
            android:textColor="@color/brand"
            android:textSize="11sp"
            android:textStyle="bold"
            android:letterSpacing="0.08" />
        <View android:layout_width="0dp" android:layout_height="0dp" android:layout_weight="1" />
        <TextView
            android:id="@+id/skip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_icon_button"
            android:paddingHorizontal="12dp"
            android:paddingVertical="8dp"
            android:text="@string/skip"
            android:textColor="@color/ink_soft"
            android:textSize="14sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/page"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingHorizontal="36dp">

        <FrameLayout
            android:id="@+id/icon_box"
            android:layout_width="200dp"
            android:layout_height="200dp">
            <ImageView
                android:id="@+id/icon"
                android:layout_width="180dp"
                android:layout_height="200dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_mercan_mark"
                android:contentDescription="@null" />
        </FrameLayout>

        <TextView
            android:id="@+id/page_title"
            style="@style/Text.Mercan.Wordmark"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:gravity="center"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/page_body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center"
            android:lineSpacingMultiplier="1.35"
            android:textColor="@color/ink_soft"
            android:textSize="16sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/footer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="24dp"
        android:paddingBottom="20dp"
        android:paddingTop="8dp">
        <LinearLayout
            android:id="@+id/dots"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center_vertical" />
        <TextView
            android:id="@+id/next"
            style="@style/Widget.Mercan.PrimaryButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="128dp"
            android:text="@string/next" />
    </LinearLayout>
</LinearLayout>
