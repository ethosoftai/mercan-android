<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/bubble"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingEnd="24dp"
    android:paddingTop="10dp"
    android:paddingBottom="6dp">

    <!-- Sender row -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        <FrameLayout
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:background="@drawable/bg_avatar">
            <ImageView
                android:layout_width="14dp"
                android:layout_height="16dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_mercan_mark"
                android:contentDescription="@null" />
        </FrameLayout>
        <TextView
            style="@style/Text.Mercan.Wordmark"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="@string/app_name"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Thinking (collapsible) -->
    <LinearLayout
        android:id="@+id/thinking_box"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_thinking"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/thinking_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="14dp"
            android:paddingEnd="8dp"
            android:paddingVertical="9dp">
            <ProgressBar
                android:id="@+id/thinking_spinner"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_marginEnd="8dp"
                android:indeterminateTint="@color/brand"
                android:visibility="gone" />
            <TextView
                android:id="@+id/thinking_label"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/thinking_done"
                android:textColor="@color/ink_soft"
                android:textSize="13sp"
                android:textStyle="bold" />
            <ImageView
                android:id="@+id/thinking_chevron"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_chevron"
                android:tint="@color/ink_faint"
                android:contentDescription="@null" />
        </LinearLayout>

        <TextView
            android:id="@+id/thinking_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="14dp"
            android:paddingEnd="12dp"
            android:paddingBottom="12dp"
            android:textColor="@color/ink_soft"
            android:textSize="14sp"
            android:lineSpacingMultiplier="1.25"
            android:textIsSelectable="true"
            android:visibility="gone" />
    </LinearLayout>

    <TextView
        android:id="@+id/message_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:textColor="@color/ink"
        android:textSize="16sp"
        android:lineSpacingMultiplier="1.32"
        android:textIsSelectable="true" />

    <TextView
        android:id="@+id/message_meta"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:visibility="gone"
        android:textSize="11sp"
        android:textColor="@color/ink_faint" />
</LinearLayout>
