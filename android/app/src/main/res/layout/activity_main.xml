<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/paper">

    <!-- ============================ Main content ============================ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="@color/paper">

        <!-- Top bar: hamburger · centred word-mark · new chat -->
        <LinearLayout
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="6dp"
            android:background="@color/paper">

            <ImageButton
                android:id="@+id/btn_menu"
                style="@style/Widget.Mercan.IconButton"
                android:src="@drawable/ic_menu"
                android:contentDescription="@string/open_drawer" />

            <LinearLayout
                android:id="@+id/title_box"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">
                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_mercan_mark"
                        android:contentDescription="@null" />
                    <TextView
                        android:id="@+id/title"
                        style="@style/Text.Mercan.Wordmark"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:singleLine="true"
                        android:ellipsize="end"
                        android:maxWidth="230dp"
                        android:text="@string/app_name"
                        android:textSize="21sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:textSize="11sp"
                    android:textColor="@color/ink_faint"
                    android:singleLine="true"
                    android:ellipsize="end"
                    android:maxWidth="240dp"
                    android:text="@string/loading" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/btn_new"
                style="@style/Widget.Mercan.IconButton"
                android:src="@drawable/ic_new"
                android:contentDescription="@string/new_chat" />
        </LinearLayout>

        <!-- Download / load progress -->
        <LinearLayout
            android:id="@+id/progress_box"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginHorizontal="16dp"
            android:layout_marginBottom="6dp"
            android:background="@drawable/bg_card_static"
            android:paddingHorizontal="16dp"
            android:paddingVertical="12dp"
            android:visibility="gone">
            <TextView
                android:id="@+id/progress_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="13sp"
                android:textColor="@color/ink_soft"
                android:singleLine="true"
                android:ellipsize="end" />
            <ProgressBar
                android:id="@+id/progress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:progressTint="@color/brand"
                android:indeterminateTint="@color/brand"
                android:max="100" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/messages"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingTop="6dp"
                android:paddingBottom="12dp"
                android:scrollbars="vertical" />

            <!-- Empty state -->
            <ScrollView
                android:id="@+id/empty_state"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fillViewport="true">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center_horizontal"
                    android:paddingHorizontal="24dp"
                    android:paddingTop="28dp"
                    android:paddingBottom="24dp">

                    <ImageView
                        android:layout_width="150dp"
                        android:layout_height="168dp"
                        android:src="@drawable/ic_mercan_mark"
                        android:contentDescription="@null" />

                    <TextView
                        style="@style/Text.Mercan.Wordmark"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="@string/app_name"
                        android:textSize="44sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:gravity="center"
                        android:lineSpacingMultiplier="1.25"
                        android:text="@string/empty_subtitle"
                        android:textColor="@color/ink_soft"
                        android:textSize="15sp" />

                    <TextView
                        style="@style/Text.Mercan.SectionHeader"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:text="@string/suggestions" />

                    <TextView android:id="@+id/suggest_1" style="@style/SuggestionCard" android:layout_marginTop="0dp" android:text="@string/suggest_1" />
                    <TextView android:id="@+id/suggest_2" style="@style/SuggestionCard" android:text="@string/suggest_2" />
                    <TextView android:id="@+id/suggest_3" style="@style/SuggestionCard" android:text="@string/suggest_3" />
                    <TextView android:id="@+id/suggest_4" style="@style/SuggestionCard" android:text="@string/suggest_4" />
                </LinearLayout>
            </ScrollView>
        </FrameLayout>

        <!-- Composer -->
        <LinearLayout
            android:id="@+id/input_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="12dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:background="@color/paper">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="bottom"
                android:background="@drawable/bg_input_pill"
                android:padding="5dp"
                android:elevation="2dp">

                <ImageButton
                    android:id="@+id/think_toggle"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:background="@drawable/bg_icon_button"
                    android:src="@drawable/ic_bulb"
                    android:tint="@color/ink_faint"
                    android:contentDescription="@string/think_off" />

                <EditText
                    android:id="@+id/input"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@null"
                    android:hint="@string/hint"
                    android:inputType="textCapSentences|textMultiLine"
                    android:imeOptions="actionSend"
                    android:maxLines="6"
                    android:minHeight="42dp"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="10dp"
                    android:textColor="@color/ink"
                    android:textColorHint="@color/ink_faint"
                    android:textSize="16sp" />

                <ImageButton
                    android:id="@+id/send"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:background="@drawable/bg_send"
                    android:src="@drawable/ic_send"
                    android:tint="@color/on_brand"
                    android:scaleType="center"
                    android:contentDescription="@string/send" />

                <ImageButton
                    android:id="@+id/stop"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:background="@drawable/bg_stop"
                    android:src="@drawable/ic_stop"
                    android:tint="@color/paper"
                    android:scaleType="center"
                    android:visibility="gone"
                    android:contentDescription="@string/stop" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:text="@string/disclaimer"
                android:textColor="@color/ink_faint"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- ============================ Drawer ============================ -->
    <LinearLayout
        android:id="@+id/drawer_panel"
        android:layout_width="304dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:orientation="vertical"
        android:background="@color/surface">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="20dp"
            android:paddingEnd="12dp"
            android:paddingTop="18dp"
            android:paddingBottom="10dp">
            <ImageView
                android:layout_width="26dp"
                android:layout_height="29dp"
                android:src="@drawable/ic_mercan_mark"
                android:contentDescription="@null" />
            <TextView
                style="@style/Text.Mercan.Wordmark"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:text="@string/app_name"
                android:textSize="24sp" />
            <ImageButton
                android:id="@+id/drawer_new"
                style="@style/Widget.Mercan.IconButton"
                android:src="@drawable/ic_edit"
                android:contentDescription="@string/new_chat" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginHorizontal="14dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_search"
            android:paddingHorizontal="12dp">
            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_search"
                android:tint="@color/ink_faint"
                android:contentDescription="@null" />
            <EditText
                android:id="@+id/search"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:background="@null"
                android:hint="@string/search_chats"
                android:inputType="text"
                android:imeOptions="actionSearch"
                android:singleLine="true"
                android:textSize="14sp"
                android:textColor="@color/ink"
                android:textColorHint="@color/ink_faint" />
        </LinearLayout>

        <TextView
            android:id="@+id/new_chat"
            style="@style/DrawerAction"
            android:layout_marginTop="10dp"
            android:drawableStart="@drawable/ic_new"
            android:drawableTint="@color/brand"
            android:text="@string/new_chat"
            android:textColor="@color/brand"
            android:textStyle="bold" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/conversations"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="4dp"
            android:clipToPadding="false"
            android:paddingHorizontal="8dp"
            android:paddingBottom="8dp" />

        <TextView
            android:id="@+id/empty_history"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="22dp"
            android:paddingVertical="8dp"
            android:text="@string/no_chats"
            android:textColor="@color/ink_faint"
            android:textSize="13sp"
            android:visibility="gone" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/line_soft" />

        <TextView
            android:id="@+id/drawer_settings"
            style="@style/DrawerAction"
            android:layout_marginTop="6dp"
            android:drawableStart="@drawable/ic_settings"
            android:text="@string/settings" />

        <TextView
            android:id="@+id/drawer_about"
            style="@style/DrawerAction"
            android:layout_marginBottom="6dp"
            android:drawableStart="@drawable/ic_info"
            android:text="@string/about" />
    </LinearLayout>
</androidx.drawerlayout.widget.DrawerLayout>
