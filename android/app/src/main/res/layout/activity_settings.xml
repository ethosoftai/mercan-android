<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/paper">

    <LinearLayout
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="6dp">
        <ImageButton
            android:id="@+id/back"
            style="@style/Widget.Mercan.IconButton"
            android:src="@drawable/ic_back"
            android:contentDescription="@string/back" />
        <TextView
            style="@style/Text.Mercan.Wordmark"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:text="@string/settings"
            android:textSize="21sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/save"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_icon_button"
            android:paddingHorizontal="14dp"
            android:paddingVertical="8dp"
            android:text="@string/save"
            android:textColor="@color/brand"
            android:textSize="15sp"
            android:textStyle="bold" />
    </LinearLayout>

    <ScrollView
        android:id="@+id/scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingHorizontal="16dp"
        android:paddingBottom="24dp">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Sohbet -->
            <TextView style="@style/Text.Mercan.SectionHeader" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/section_chat" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card_static"
                android:padding="16dp">

                <TextView style="@style/Text.Mercan.Label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/system_prompt" />
                <EditText
                    android:id="@+id/system_prompt"
                    style="@style/Widget.Mercan.Field"
                    android:hint="@string/system_prompt_hint"
                    android:inputType="textCapSentences|textMultiLine"
                    android:minLines="3"
                    android:maxLines="8"
                    android:gravity="top|start" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/system_prompt_help"
                    android:textColor="@color/ink_faint"
                    android:textSize="12sp" />

                <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginVertical="14dp" android:background="@color/line_soft" />

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/setting_thinking" android:textColor="@color/ink" android:textSize="15sp" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/setting_thinking_help" android:textColor="@color/ink_faint" android:textSize="12sp" />
                    </LinearLayout>
                    <Switch android:id="@+id/sw_thinking" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                </LinearLayout>

                <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginVertical="14dp" android:background="@color/line_soft" />

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/setting_typewriter" android:textColor="@color/ink" android:textSize="15sp" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/setting_typewriter_help" android:textColor="@color/ink_faint" android:textSize="12sp" />
                    </LinearLayout>
                    <Switch android:id="@+id/sw_typewriter" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                </LinearLayout>
            </LinearLayout>

            <!-- Üretim -->
            <TextView style="@style/Text.Mercan.SectionHeader" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/section_generation" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card_static"
                android:padding="16dp">

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:layout_marginEnd="8dp">
                        <TextView style="@style/Text.Mercan.Label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/set_temperature" />
                        <EditText android:id="@+id/temperature" style="@style/Widget.Mercan.Field" android:inputType="numberDecimal" />
                    </LinearLayout>
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:layout_marginStart="8dp">
                        <TextView style="@style/Text.Mercan.Label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/set_max_tokens" />
                        <EditText android:id="@+id/max_tokens" style="@style/Widget.Mercan.Field" android:inputType="number" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="12dp">
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:layout_marginEnd="8dp">
                        <TextView style="@style/Text.Mercan.Label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Top-p" />
                        <EditText android:id="@+id/top_p" style="@style/Widget.Mercan.Field" android:inputType="numberDecimal" />
                    </LinearLayout>
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:layout_marginStart="8dp">
                        <TextView style="@style/Text.Mercan.Label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Top-k" />
                        <EditText android:id="@+id/top_k" style="@style/Widget.Mercan.Field" android:inputType="number" />
                    </LinearLayout>
                </LinearLayout>

                <TextView style="@style/Text.Mercan.Label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="@string/set_repeat" />
                <EditText android:id="@+id/repeat" style="@style/Widget.Mercan.Field" android:inputType="numberDecimal" />

                <TextView
                    android:id="@+id/reset_generation"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_icon_button"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="6dp"
                    android:text="@string/reset_defaults"
                    android:textColor="@color/brand"
                    android:textSize="14sp" />
            </LinearLayout>

            <!-- Model -->
            <TextView style="@style/Text.Mercan.SectionHeader" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/section_model" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card_static"
                android:padding="16dp">
                <TextView android:id="@+id/model_info" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/ink_soft" android:textSize="13sp" android:lineSpacingMultiplier="1.3" />
                <TextView style="@style/Text.Mercan.Label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:id="@+id/threads_label" />
                <EditText android:id="@+id/threads" style="@style/Widget.Mercan.Field" android:inputType="number" />
                <TextView
                    android:id="@+id/import_model"
                    style="@style/Widget.Mercan.SecondaryButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="@string/import_model" />
            </LinearLayout>

            <!-- Veri -->
            <TextView style="@style/Text.Mercan.SectionHeader" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/section_data" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card_static"
                android:padding="16dp">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/data_help" android:textColor="@color/ink_soft" android:textSize="13sp" android:lineSpacingMultiplier="1.3" />
                <TextView
                    android:id="@+id/delete_all"
                    style="@style/Widget.Mercan.SecondaryButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/delete_all_chats"
                    android:textColor="@color/danger" />
            </LinearLayout>

            <TextView
                android:id="@+id/version"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:gravity="center"
                android:textColor="@color/ink_faint"
                android:textSize="12sp" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
